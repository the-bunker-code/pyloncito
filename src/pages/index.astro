---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pyloncito">
  <main class="mx-auto flex min-h-dvh max-w-4xl flex-col justify-center px-6 py-12">
    <p class="text-sm font-semibold tracking-wide text-orange-700 uppercase">
      Aprender jugando, tapita a tapita
    </p>
    <h1 class="mt-3 text-5xl font-bold tracking-tight text-slate-900">Pyloncito</h1>
    <p class="mt-4 max-w-xl text-lg text-slate-700">
      Cuatro juegos para mirar, contar, recordar y hablar.
    </p>
    <p class="mt-8 rounded-2xl border border-amber-200 bg-white/70 p-4 text-sm text-slate-600">
      Base en construcción. Los juegos llegan en las próximas fases.
    </p>
  </main>
</BaseLayout>
