---
interface Props {
  mood?: 'idle' | 'happy' | 'think';
  class?: string;
}

const { mood = 'idle', class: className = '' } = Astro.props;

function scallopedEdge(points = 22, outer = 48, inner = 44) {
  return Array.from({ length: points * 2 }, (_, index) => {
    const angle = (Math.PI * index) / points;
    const radius = index % 2 === 0 ? outer : inner;
    return `${(50 + radius * Math.cos(angle)).toFixed(1)},${(50 + radius * Math.sin(angle)).toFixed(1)}`;
  }).join(' ');
}

const edge = scallopedEdge();
---

<svg class:list={['mascot', className]} viewBox="0 0 100 100" aria-hidden="true">
  <polygon points={edge} fill="#d93b30"></polygon>
  <circle cx="50" cy="50" r="39" fill="#ff5f52"></circle>
  <circle
    cx="50"
    cy="50"
    r="35"
    fill="none"
    stroke="#ffffff66"
    stroke-width="2"
    stroke-dasharray="3 4"
  ></circle>
  <ellipse
    cx="36"
    cy="27"
    rx="12"
    ry="5.5"
    fill="#ffffff55"
    transform="rotate(-22 36 27)"
  ></ellipse>
  {mood === 'happy' ? (
    <g>
      <path
        d="M29 46 q7 -9 14 0 M57 46 q7 -9 14 0"
        stroke="#3b1d12"
        stroke-width="4.5"
        fill="none"
        stroke-linecap="round"
      />
      <path d="M35 58 q15 17 30 0 z" fill="#7a2a1a" />
      <path d="M43 65 q7 5 14 0" fill="#ff8f86" />
    </g>
  ) : mood === 'think' ? (
    <g>
      <circle cx="37" cy="45" r="6" fill="#3b1d12" />
      <circle cx="63" cy="45" r="6" fill="#3b1d12" />
      <circle cx="35" cy="42" r="2.2" fill="#fff" />
      <circle cx="61" cy="42" r="2.2" fill="#fff" />
      <path
        d="M29 34 l12 -3 M59 31 l12 3"
        stroke="#3b1d12"
        stroke-width="3"
        stroke-linecap="round"
      />
      <ellipse cx="50" cy="63" rx="4.5" ry="4" fill="#7a2a1a" />
    </g>
  ) : (
    <g>
      <circle cx="37" cy="46" r="6.5" fill="#3b1d12" />
      <circle cx="63" cy="46" r="6.5" fill="#3b1d12" />
      <circle cx="39" cy="44" r="2.4" fill="#fff" />
      <circle cx="65" cy="44" r="2.4" fill="#fff" />
      <path
        d="M38 59 q12 10 24 0"
        stroke="#7a2a1a"
        stroke-width="4"
        fill="none"
        stroke-linecap="round"
      />
    </g>
  )}
  <ellipse cx="27" cy="58" rx="6" ry="4" fill="#ffaaa0"></ellipse>
  <ellipse cx="73" cy="58" rx="6" ry="4" fill="#ffaaa0"></ellipse>
</svg>
