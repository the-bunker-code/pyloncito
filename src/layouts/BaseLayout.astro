---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Juegos para aprender jugando.' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffe7b8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-amber-50 font-[var(--font-kid)] text-slate-900">
    <slot />
  </body>
</html>
