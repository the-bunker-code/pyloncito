{
  "name": "pyloncito",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sistema de juegos educativos para aprender jugando.",
  "license": "MIT",
  "author": "Enrique Lazo Bello (ENLABE), The Bunker Code and contributors",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "astro dev",
    "new-game": "node scripts/new-game.ts",
    "cloudflare:branching": "node scripts/configure-cloudflare-builds.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check && vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "check:full": "pnpm check && pnpm test:coverage"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/vue": "7.1.2",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "tailwindcss": "4.3.3",
    "vue": "3.5.44",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13",
    "wrangler": "4.154.0"
  }
}
